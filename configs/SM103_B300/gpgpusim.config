# B300 (SM103, "NVIDIA B300 SXM6 AC") FlashGPU-Sim config, calibrated on real
# hardware (B300 SXM6, CUDA 13.2, ncu 2026.1.1) via Auto-Microbench + FlashGPU-Sim
# microbenches, Nov 2026. Base: configs/SM100_B200 (flash 7a48f768).
#
# Calibration point: actual B300 workpoint SM 2032 / L2 1981 / DRAM 3996 MHz —
# clocks cannot be locked on this platform (no permission, ncu --clock-control
# has no effect), so all HW cycles were measured at the ~2031-2032 MHz boost.
# L2 1981 MHz = 2032 x lts__cycles/sm__cycles (ncu: 1.96/2.01).
#
# Uses -ptx_opcode_initiation_ex2
# (EX2 has 2x MUFU issue rate on B300: HW 31.99 vs 16 ops/cyc/SM).
#
# Known model limits (documented, not calibratable):
#  - L1 hit latency: sim floor ~58c (l1_latency=1) vs HW 39.5c.
#  - hbm_bw end-to-end: sim caps at ~5.11 TB/s regardless of DRAM service
#    rate / inflight / MSHR / queues (6 attempts; HW 6.99 TB/s). DRAM unit
#    test reaches the configured 7.16 TB/s nominal, so the cap is upstream
#    (SM/interconnect path), not the DRAM model.

# Device facts: 148 SMs, SM 2032MHz, mem 3996MHz, bus 7680-bit,
# L2 132644864 B, 32 blocks/SM, 228/227 KiB smem. CC kept at 10.0 so sm_100a PTX
# microbenchmarks keeps running unchanged in the simulator.

# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 100

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 6422 # [B300v2] was 5000; target empty kernel <<<148,512>>> gpc__cycles_elapsed.max=6434 sim=6434
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 10
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0
-gpgpu_ptx_reorder 1
-gpgpu_ptx_reorder_sass_guided 1

# high level architecture configuration
-gpgpu_n_clusters 148
-gpgpu_n_cores_per_cluster 1
# 16 channels are kept; the aggregate DRAM rate below is what matters.
-gpgpu_n_mem 16
-gpgpu_n_sub_partition_per_mchannel 12

# Clock domains in MHz: core:interconnect:L2:DRAM.
# ratio (1155 @ 1080) must be re-measured on B300 at the chosen lock point.
# [B300 calib] core/L2/mem clocks locked at observed HW workpoint: SM 2031-2032MHz (unlocked boost), L2 1981MHz (from ncu lts/sm=1.96/2.01*2032), DRAM 3996MHz.
-gpgpu_clock_domains 2032:2032:1981:3996

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 100

# B200 supports 64 resident warps (2048 threads) per SM.
-gpgpu_shader_core_pipeline 2048:32
# [B300] cudaDevAttrMaxBlocksPerMultiprocessor = 32 on B300 (B200 config: 24).
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE,ID_OC_TMA,OC_EX_TMA,ID_OC_CP_ASYNC,OC_EX_CP_ASYNC
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4,4,4,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
# Expose ALU dependent results before physical writeback while retaining
# execution occupancy.
-gpgpu_alu_scoreboard_forwarding 1
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4
# TCGen05 MMA issue spacing and completion tail in core cycles; service in
# FLOP/SM-cycle.
-ptx_opcode_tcgen05_mma_issue_interval 1
# [B300] tcgen05 tail=201 -> sim intercept a=244.1c vs HW a=243.2c (MMA->commit->mbarrier total; sim T0=13 vs HW 106, b=131.5 vs HW 131.4).
-ptx_opcode_tcgen05_mma_completion_tail_latency 238 # [B300v2] was 201; target tc_tail N=256 a=243.2 sim=243.1
-ptx_opcode_tcgen05_mma_f16_flops_per_cycle 8192
-gpgpu_tcgen05_async_queue_depth 0
-gpgpu_num_tma_units 1
-gpgpu_num_cp_async_units 1
# TMA and ordinary cp.async each use 32-byte sector requests and can consume
# the full four-sector local request/response budget when running alone.
-gpgpu_tma_request_granularity 32
-gpgpu_tma_request_width 4
-gpgpu_tma_response_width 4
-gpgpu_cp_async_request_granularity 32
-gpgpu_cp_async_request_width 4
-gpgpu_cp_async_response_width 4
# Maximum outstanding TMA child requests per SM; 0 means unlimited.
# [B300] tma_max_inflight = 4 x HW cold-DRAM dependent-load 682.5c = 2728.
-gpgpu_tma_max_inflight 2728
# Route out-of-bounds TMA fill requests through L2.
-gpgpu_tma_oob_l2_traffic 1
# CTA load balancing: cap CTAs per core to ceil(total_ctas / n_cores)
-gpgpu_cta_load_balance 1
# CTA slot reuse delay after resource release, in core cycles; first use is
# immediate.
# tests/src/microbench/cta run-hw on B300.
# [B300] cta_replacement=157: baseline gap 361c + 157 = sim 517.0c vs HW 517.5c median.
-gpgpu_cta_replacement_latency 1187 # [B300v2] was 157; target cta_gap tmem=1 (gap+active)=3726 sim=3726 (folds unmodeled TMEM alloc/dealloc; over-penalizes non-TMEM kernels: tmem=0 gap 1541 vs HW 536)
# mbarrier arrive_tx shared memory write latency (cycles)
-gpgpu_mbarrier_arrive_latency 37 # [B300v2] was 29; target mbar_self=53.0 sim=53.5
# Maximum no-hint try_wait suspension in core cycles; explicit hints
# override it.
-gpgpu_mbarrier_trywait_latency 32
# Additional delay for a successful phase-notified try_wait, in core cycles.
-gpgpu_mbarrier_phase_wakeup_latency 72 # [B300v2] was 110; target mbar_pingpong one_way=78.4; sim response is discontinuous (71->36.7, 72->84.5, full v2 matrix 36.3) - interacts with -gpgpu_mbarrier_trywait_latency 32, unresolved

# Instruction latencies and initiation intervals
# [B300] int_latency: ADD=5 (HW 5.02c dep chain), MUL/MAD=4 (HW mad.lo.s32 pair 8.05/2=4.02c). DIV/SHF unchanged from B200.
-ptx_opcode_latency_int 5,4,4,4,21,14
# [B300] int MUL/MAD initiation=2 (HW 64.0 ops/cyc/SM, 128/64=2).
-ptx_opcode_initiation_int 1,1,2,2,2,4
# 32-bit integer logic/shift result latency and issue interval in core cycles.
-ptx_opcode_latency_int_logic 4
-ptx_opcode_initiation_int_logic 2
# SETP/SELP result latency in core cycles.
-ptx_opcode_latency_predicate 5
# [B300] fp[1] MAX=6 (HW minmax pair 10.04-FADD4.04=6.0c; sim verified 10.01). fp[0]=4 (HW 4.04), DIV unchanged.
-ptx_opcode_latency_fp 4,6,4,4,39
# Route scalar FP32 min/max through the INT execution path.
-ptx_opcode_f32_minmax_use_int 1
# [B300] fp_init[1]=2 (HW minmax 63.1 ops/cyc/SM -> 128/63.1=2.03). others HW-verified unchanged.
-ptx_opcode_initiation_fp 1,2,1,1,2
# Packed f32x2 issue interval in core cycles; result latency follows scalar
# FP timing.
-ptx_opcode_initiation_f32x2 2
# Packed f32-to-f16 conversion result latency and issue interval in core cycles.
-ptx_opcode_latency_cvt_f16x2_f32 4
-ptx_opcode_initiation_cvt_f16x2_f32 2
# CC 10.3 FP32:FP64 = 64:1 (CUDA Programming Guide), i.e. 2 FP64 FMA/clk/SM;
-ptx_opcode_latency_dp 64,64,64,64,330
# [B300] DP initiation=76 (HW fp64 1.684 FMA/cyc/SM -> 128/1.684).
-ptx_opcode_initiation_dp 76,76,76,76,130
# [B300] MUFU latency=20 (HW rcp+add 24.04=20+4; sin chain measured 24.04 raw incl +4 model semantics).
-ptx_opcode_latency_sfu 20
# EX2 result latency in core cycles.
# [B300] EX2 latency=14 (HW 14.04c dep chain).
-ptx_opcode_latency_ex2 14
# [B300] MUFU.EX2 throughput is 2x on Blackwell Ultra (NVIDIA softmax blog:
# this halves the interval for every SFU op; check on B300 which other MUFU
# ops (rcp/rsqrt/lg2/sin/cos/tanh) actually doubled.
# [B300] SFU initiation=8 (HW sin/rcp/rsqrt/lg2/tanh 16 ops/cyc/SM -> 128/16).
-ptx_opcode_initiation_sfu 8
# [B300] EX2 initiation=4 (HW 31.99 ops/cyc/SM -> 128/32).
-ptx_opcode_initiation_ex2 4
# mma latency and initiation following tensor_mma.h:
# tensor[0]: m16n8k16fp16 and default value for unsupported instructions
# tensor[1,2,3]: m16n8k8tf32, m16n8k32int8, m16n8k8fp16
# tensor[4,5,6]: m16n8k8bf16, m16n8k4tf32, m16n8k16int8
# [B300] tensor[0]=20 (HW mma.sync m16n8k16 fp16 latency 20.08c). others inherited.
-ptx_opcode_latency_tensor 20,32,19,32,32,32,19
-ptx_opcode_initiation_tensor 34,32,19,32,32,32,19
# TMA instruction latency and issue interval in core cycles.
-ptx_opcode_latency_tma 32 # [B300v2] was 32; no effect on p50 (635@32, 635@287); crashes bitset bound at >=512 -> kept original
-ptx_opcode_initiation_tma 32

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors
# instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 16
-gpgpu_operand_collector_num_in_ports_gen 16
-gpgpu_operand_collector_num_out_ports_gen 16
# register banks
-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 4

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1
# cache
# For more info, see
# https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,32:0,32
# [B300] l1_latency=1: sim chase floor ~58c vs HW 39.48c; closest achievable (structural minimum in model).
-gpgpu_l1_latency 1
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_n_ldst_response_buffer_size 4
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 233472
-gpgpu_shmem_per_block 49152
-gpgpu_shmem_per_block_optin 232448
# [B300] smem_latency=15 -> sim 29.0c == HW 29.0c (B200 was 19).
-gpgpu_smem_latency 15
-gpgpu_smem_store_visibility_latency 4
-gpgpu_named_barrier_arrive_latency 18
-gpgpu_named_barrier_arrive_visibility_latency 0 # [B300v2] was 24; target nbar_pingpong one_way=40.1 sim=46.0 (floor 0, residual +15%)
# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_ldmatrix_min_dispatch_cycles 4
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 100

# L2 cache geometry and per-slice sector MSHR/queue capacities.
-gpgpu_cache:dl2 S:256:128:21,L:B:m:L:P,A:768:128,32:0,32
# L2 lookup/data/fill service in 32-byte sectors per L2 tick.
# Data service uses a numerator and cycle period.
-gpgpu_l2_multi_issue_port_model 1
-gpgpu_l2_lookup_sectors_per_cycle 3
-gpgpu_l2_data_port_sectors_per_cycle 5
-gpgpu_l2_data_port_cycle_period 3
-gpgpu_l2_fill_port_sectors_per_cycle 3
# Share outstanding same-sector reads, retaining each requester completion.
-gpgpu_l2_tma_request_coalescing 1
# Nominal validation target consumed by the config-driven L2 bandwidth test.
# [B300] expected L2 bw = 5/3*32*192*1981MHz = 20.285TB/s; unit test measured 20.13TB/s vs HW 19.62TB/s (+2.6%).
-gpgpu_l2_expected_bandwidth_TBp 20.28
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 0
-gpgpu_non_power2_l2_slice_mapping 1
# Channel selection for a non-power-of-two L2 topology.
-gpgpu_non_power2_l2_channel_indexing 2

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:32:32,32
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Legacy texture cache; modern .nc loads use L1D.
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1
# Keep blocked destinations independent within shared input budgets.
-icnt_use_voq 1
-icnt_tma_request_multicast 1
-icnt_tma_response_multicast 1
-icnt_request_input_sectors_per_cycle 4
-icnt_request_output_sectors_per_cycle 4
-gpgpu_l2_request_ingress_sectors_per_cycle 4
-gpgpu_l2_response_egress_sectors_per_cycle 4
-icnt_reply_input_sectors_per_cycle 4
-icnt_reply_output_sectors_per_cycle 4
-gpgpu_cluster_response_ingress_sectors_per_cycle 4
-gpgpu_cluster_response_dispatch_sectors_per_cycle 4
-gpgpu_ldst_request_width 4
-gpgpu_ldst_response_sectors_per_cycle 4

# memory partition latency config
# [B300] l2_rop=286 -> sim 284.2c vs HW 285.4c (l2_latency_bench .cg hit).
-gpgpu_l2_rop_latency 286
# Ready ROP-delay output width in 32-byte sectors per L2 tick.
-gpgpu_l2_rop_delay_output_sectors_per_cycle 2
# Fixed DRAM-path delay in core cycles.
# [B300] dram_latency=666 -> sim 665.6c vs HW 659.2c (l2_latency_bench miss, cold).
-dram_latency 666
# Keep the existing coarse L2 locality model disabled. The uniform DRAM
# approximation does not classify local and remote die accesses.
-gpgpu_l2_partition_count 1
-gpgpu_l2_partition_extra_latency 0

# dram sched config
-gpgpu_simple_dram_model 1
# Simple DRAM service rate: numerator/denominator transfer atoms per DRAM tick.
# peak (960 B x 7.992 GT/s); re-measure the achievable rate with hbm_bw_bench.
# [B300] dram service rate 7/2=3.5 atoms/tick -> nominal 7.161TB/s (physical peak 7.672). End-to-end hbm_bw caps at 5.11TB/s (structural sim limit, see header). HW 6.99TB/s.
-gpgpu_simple_dram_service_rate_num 7
-gpgpu_simple_dram_service_rate_den 2
# Nominal validation target consumed by the config-driven DRAM bandwidth test.
# [B300] expected dram bw nominal 7.16TB/s.
-gpgpu_dram_expected_bandwidth_TBp 7.16
# Maximum outstanding simple-DRAM requests per controller;
# 0 derives the limit from detailed DRAM queue sizes.
# [B300] dram inflight = 666/2032 x 3996 x 3.5 = 4584 + headroom = 4590 (unit test observed 4585 at 7.161TB/s).
-gpgpu_simple_dram_max_inflight 4590
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 384

# dram model config
-gpgpu_n_mem_per_ctrlr 1
# One simulator DRAM transfer atom is one 32-byte sector.
-gpgpu_dram_buswidth 16
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing (retained for detailed-model fallback; bypassed while the simple
# aggregate service model above is enabled)
-gpgpu_dram_timing_opt nbk=16:CCD=4:RRD=12:RCD=24:RAS=55:RP=24:RC=78:CL=24:WL=8:CDLR=10:WR=24:nbkgrp=4:CCDL=6:RTPL=4
-dram_dual_bus_interface 0

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# Power model enable.
-power_simulation_enabled 0

# tracing functionality
-trace_enabled 0
-trace_components LIVENESS
-trace_sampling_core -1
-gpgpu_barrier_release_latency 40 # [B300v2] was 0; target nbar_sync512=50.5 sim=50.5
-ptx_opcode_tcgen05_st_completion_latency 10,10,10,13,16,23,38,70 # [B300v2] was default; target st_lat; x8/x64/x128 HW-derived
-ptx_opcode_tcgen05_ld_completion_latency 29,29,30,32,36,44,60,92 # [B300v2] was default; target ld_lat wait; x8/x64/x128 HW-derived
-ptx_opcode_tcgen05_ld_initiation_interval 1,1,1,1,1,1,1,1 # [B300v2] unchanged: HW aggregate 0.2-0.68 cyc/op is below the sim floor of 1
